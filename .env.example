# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL.
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anonymous public key.
SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_KEY: Your Supabase service role key (server-side only).
SUPABASE_SERVICE_KEY="your-service-role-key"

# SESSION_SECRET: Secret key for session signing.
SESSION_SECRET="your-session-secret"

# NODE_ENV: Environment (development, production).
NODE_ENV="development"

# PORT: Server port.
PORT=3000

# RATE_LIMIT_WINDOW_MS: Rate limiting window in milliseconds (default: 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX_REQUESTS: Max requests per window per IP (default: 100).
RATE_LIMIT_MAX_REQUESTS=100

# DATA_RETENTION_DAYS: Number of days to retain deleted data before permanent deletion (default: 30).
DATA_RETENTION_DAYS=30

# OPERATOR_NAME: Name of the data operator (ФЗ-152 Article 5).
OPERATOR_NAME="РЯДОМ НСК"

# OPERATOR_ADDRESS: Address of the data operator.
OPERATOR_ADDRESS="г. Новосибирск"

# OPERATOR_CONTACT: Contact email for data protection questions.
OPERATOR_CONTACT="privacy@ryadom.nsk"

# ADMIN_EMAIL: Administrator email for moderation notifications.
ADMIN_EMAIL="admin@ryadom.nsk"
